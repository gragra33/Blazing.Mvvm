@page "/signout"
@inherits MvvmComponentBase<SignOutViewModel>

<PageTitle>Signed Out</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="card-title mb-3">
                        Successfully Signed Out
                    </h2>

                    <p class="text-muted mb-4">
                        You have been signed out at <strong>@ViewModel.SessionTime</strong>
                    </p>

                    @if (ViewModel.ShowRedirectNotice)
                    {
                        <div class="alert alert-info mb-4" role="alert">
                            <i class="bi bi-info-circle"></i> 
                            You will be redirected to the home page in <strong>@ViewModel.TimeLeft</strong> seconds...
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" 
                                @onclick="ViewModel.SignInAgainCommand.Execute">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In Again
                        </button>
                        <button class="btn btn-secondary" 
                                @onclick="ViewModel.GoToHomeCommand.Execute">
                            <i class="bi bi-house-door"></i> Go to Home
                        </button>
                    </div>

                    <hr class="my-4">

                    <p class="text-muted small mb-0">
                        <i class="bi bi-shield-check"></i> Your session has been terminated securely
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
