@inherits MvvmLayoutComponentBase<Blazing.Mvvm.Security.Wasm.ViewModels.MainLayoutViewModel>

<!-- warn user that they're going to be logged out - NOTE: can not change the browser's native confirm dialog -->
<NavigationLock ConfirmExternalNavigation="@ViewModel.SessionLockService.ShouldLockNavigation" OnBeforeInternalNavigation="ViewModel.OnBeforeInternalNavigationAsync" />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span aria-label="navigation count">Navigation Count: @ViewModel.Counter</span>
            <div class="d-flex align-items-center gap-3">
                <LoginDisplay />
                <a href="https://github.com/gragra33/Blazing.Mvvm/" target="_blank">About</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

